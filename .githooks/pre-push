#!/usr/bin/env bash
#
# Offers an adversarial review of the commits being pushed. NEVER blocks the
# push: it asks once, and whatever you answer -- including not answering -- the
# push proceeds. Every failure path is also exit 0, because a broken reviewer
# must never stand between an engineer and their remote.
#
# Answer y and a detached worker reviews the pushed range while the push runs;
# REVIEW.md (gitignored, repo root) opens when it lands. Answer anything else,
# or nothing, and the hook does nothing at all.
#
# git calls this with argv: $1 = remote name, $2 = remote URL, and feeds one
# line per ref on stdin:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# stdin is therefore NOT the terminal, which is why the prompt below reads from
# /dev/tty. It is also the only place range information exists, readable exactly
# once, by this process -- so the parsing happens here rather than in the
# worker. Guessing the range from @{u} afterwards gets force-pushes and first
# pushes of a new branch wrong.
#
# bash, not sh: `read -t` (the prompt timeout) is not POSIX.
#
# Install (both operators, macOS and WSL):
#     git config core.hooksPath .githooks
#
# Configure: .githooks/review.conf

set -u

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
WORKER="$REPO_ROOT/.githooks/review-worker.sh"
[ -x "$WORKER" ] || exit 0

REMOTE_NAME="${1:-origin}"
ZERO=0000000000000000000000000000000000000000

# Read every ref line before anything slow, and before the prompt: this is the
# hook's stdin and it does not survive. Branch deletions carry an all-zero
# local sha and have no diff to review.
SPEC=$(mktemp "${TMPDIR:-/tmp}/prepush-review.XXXXXX" 2>/dev/null) || exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" = "$ZERO" ] && continue
    printf '%s %s %s %s\n' \
        "$local_ref" "$local_sha" "${remote_ref:-}" "${remote_sha:-$ZERO}" >>"$SPEC"
done

if [ ! -s "$SPEC" ]; then
    rm -f "$SPEC"
    exit 0
fi

# shellcheck source=/dev/null
[ -f "$REPO_ROOT/.githooks/review.conf" ] && . "$REPO_ROOT/.githooks/review.conf"
REVIEW_PROMPT_TIMEOUT="${REVIEW_PROMPT_TIMEOUT:-30}"

# Asking requires someone to ask. Pushes from CI, scripts, editors and GUI
# clients have no terminal; they skip silently rather than hanging on a prompt
# nobody can see.
#
# The check has to be an actual open, not `[ -r /dev/tty ]`: the device node
# exists with readable permission bits even when nothing is attached to it, so
# the test passes and every subsequent redirect then fails with "Device not
# configured". Opening it once on fd 3 both proves a terminal is there and
# gives the prompt something to talk to.
if [ -n "${CI:-}" ]; then
    rm -f "$SPEC"
    exit 0
fi
if ! { exec 3<>/dev/tty; } 2>/dev/null; then
    rm -f "$SPEC"
    exit 0
fi

# Enough context to answer the question: which branch, and how much is new.
first_line=$(head -1 "$SPEC")
# shellcheck disable=SC2034
read -r p_ref p_head p_rref p_rsha <<<"$first_line"
branch="${p_ref#refs/heads/}"
if [ "$p_rsha" != "$ZERO" ] && git cat-file -e "${p_rsha}^{commit}" 2>/dev/null; then
    n_commits=$(git rev-list --count "${p_rsha}..${p_head}" 2>/dev/null || echo "?")
    span="$(git rev-parse --short "$p_rsha" 2>/dev/null)..$(git rev-parse --short "$p_head" 2>/dev/null)"
else
    n_commits=$(git rev-list --count "$p_head" --not --remotes="$REMOTE_NAME" 2>/dev/null || echo "?")
    span="new branch"
fi
[ "$(wc -l <"$SPEC" | tr -d ' ')" -gt 1 ] && branch="$branch (+more refs)"

printf '\n\033[1mLocal review\033[0m  %s  %s  %s commit(s)\n' "$branch" "$span" "$n_commits" >&3
printf 'Would you like a local review? [y/N] ' >&3

reply=""
read -r -t "$REVIEW_PROMPT_TIMEOUT" reply <&3 || reply=""

case "$reply" in
    [Yy] | [Yy][Ee][Ss])
        ;;
    *)
        printf 'Skipped.\n\n' >&3
        rm -f "$SPEC"
        exit 0
        ;;
esac

LOG="$REPO_ROOT/.githooks/.review-state/worker.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null

# Which terminal to report back to when the review lands, minutes from now.
# The worker is detached and has no controlling terminal of its own, so the
# path has to be captured here, while fd 3 is still the tty, and carried over
# in the environment. `tty` reads its own stdin, hence the <&3.
REVIEW_TTY=$(tty <&3 2>/dev/null) || REVIEW_TTY=""
export REVIEW_TTY

# Deliberately no filename here. The worker picks between REVIEW.md and
# REVIEW-<base>.md depending on what already exists, and it resolves the base
# itself, so only it can name the file correctly. Printing a guess would be
# wrong exactly when a previous review is still sitting there.

# Detach, twice over.
#
# Redirecting all three descriptors is what frees git to proceed: a background
# child still holding the hook's stdout can make the push appear to hang until
# the review finishes, which is the one behaviour this hook exists to avoid.
#
# Leaving the terminal's process group matters just as much. `nohup` only
# covers SIGHUP, so a worker left in the group dies with the terminal -- push
# and close the tab and the review never happens. setsid puts it in a fresh
# session outright; where there is no setsid (macOS ships none), the subshell
# form forks and exits immediately, orphaning the worker onto init, which
# survives the same teardown. Verified by tearing a pty down under it.
if command -v setsid >/dev/null 2>&1; then
    setsid "$WORKER" "$REMOTE_NAME" "$SPEC" </dev/null >>"$LOG" 2>&1 &
else
    ( nohup "$WORKER" "$REMOTE_NAME" "$SPEC" </dev/null >>"$LOG" 2>&1 & )
fi

printf 'Review started; the path prints here when it lands.\n\n' >&3
exit 0

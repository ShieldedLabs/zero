# Zeronym one-shot deploy config.  Copy to `deploy.env` (gitignored) and fill in.
# Then:  export VULTR_API_KEY=...  &&  caution login --qr --username <name>  &&  ./zeronym/deploy.sh
#
# The secret VULTR_API_KEY is read from your ENVIRONMENT, never from this file.

# Which component to deploy: shim | hub
COMPONENT=shim

# App/enclave name (a FRESH app is created every run — managed apps are immutable).
NAME=zeronym-shim

# The TLS domain the component serves. MUST be a label under DNS_DOMAIN below.
TLS_DOMAIN=test-shim-nym-1.shieldedinfra.net

# ---- shim inputs (COMPONENT=shim) ----
BACKEND=66.241.124.200:443          # backing indexer, literal IPv4:port
BACKEND_TLS=na.zec.rocks            # the name its cert must carry
HUB_NYM=41pY2atgQD2iQkvC2TnKaxkUDGkqfxU9XBtQEk2GmJqD.HdjEPfnu2u5DV3jbZqZ6NJEhr1U5u9r41Gt8qncoByHx@tUiLPjz5nkPn5ZJT5ZXLPGDcZ3caQsfkMAp1epoAuSQ
#   ^ omit HUB_NYM for a forward-only shim (no diversion).

# ---- hub inputs (COMPONENT=hub) ----
INDEXERS=66.241.124.200:443         # comma-separated literal IPv4:port list
INDEXER_TLS=na.zec.rocks
NYM=1                               # 1 = run the hub's own mixnet client

# ---- nym egress (both), space-separated  cidr:port[:proto] ----
#
# The two 443 hosts are nym-api endpoints. The SDK ships THREE and shuffles them
# on every client build, rotating on failure; an enclave allowlist DROPS blocked
# packets rather than refusing them, so each blocked attempt waits out the SDK's
# full 30 s timeout. With only one allowed, ~2/3 of client builds started on a
# dead endpoint and paid 30-60 s before fetching any topology -- invisible,
# because it happens before mixnet_connected flips true, but it lengthened every
# rebuild and every startup. Two of three cuts that to ~1/3.
#
#   92.39.63.14      validator.nymtech.net   (single host)
#   172.104.178.252  cdn1.media-platform.net (single host)
#
# The third built-in, nym-frontdoor.global.ssl.fastly.net, is deliberately NOT
# here: it resolves to shared Fastly anycast edges, and allowlisting those would
# let the enclave reach every origin fronted by that CDN. Both IPs above are DNS
# snapshots, not configuration -- re-derive them (dig +short <name>) on every
# redeploy or they rot silently. The proper fix, tracked in PRODUCTION.md, is to
# hand the SDK ONLY the endpoints we allow via NymNetworkDetails, so no attempt is
# ever blocked; until then this is the best the allowlist can do.
NYM_EGRESS="92.39.63.14/32:443:tcp 172.104.178.252/32:443:tcp 0.0.0.0/0:9000:tcp 1.1.1.1/32:53:udp"

# ---- debug vs attested ----
DEBUG=1                             # 1 = debug enclave (SSH console on); 0 = attested
SSH_PUBKEY_FILE=$HOME/.ssh/id_ed25519.pub
# Required when DEBUG=0. The PUBLIC repo `caution verify` clones and rebuilds from;
# deploy.sh also PUSHES the assembled tree there (main + a deploy-<app-id> tag),
# because Caution's own remote is push-only. One repo per app, reused across
# redeploys. Nothing secret goes in it (backend IP, hub address, egress are public;
# only an SSH *public* key). shim -> zero-shim, hub -> zero-hub.
APP_SOURCE=                         # e.g. https://github.com/ShieldedLabs/zero-shim  (hub: .../zero-hub)
APP_SOURCE_PUSH=                    # optional: push URL if it differs from the https clone URL, e.g. git@github.com:ShieldedLabs/zero-shim.git
# APP_SOURCE_TAG=                   # optional: override the default deploy-<app-id> tag

# ---- Vultr DNS ----
DNS_DOMAIN=shieldedinfra.net        # the zone hosted on Vultr
DNS_TTL=300
DNS_CNAME_TRAILING_DOT=1            # 1 = write CNAME data absolute (a.b.c.) so Vultr never appends the zone

# ---- behaviour ----
REDEPLOY_DESTROY_OLD=0              # 1 = destroy the app in this dir's .caution/deployment.json before creating

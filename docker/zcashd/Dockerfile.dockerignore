# BuildKit reads <Dockerfile>.dockerignore next to the Dockerfile in preference
# to the context root's .dockerignore, so this file filters the vendored
# `zcashd/` build context without adding a [zero] delta inside the subtree.
#
# Goal: keep test/doc-only churn from invalidating the COPY layers (and with
# them the zcashd build). Everything zcutil/build.sh needs stays included.
#
# configure.ac generates doc/man/Makefile and qa/pull-tester/tests_config.ini,
# so those two subdirectories must remain in the context (re-included below;
# last match wins).
qa
!qa/pull-tester
doc
!doc/man
.github
**/*.md

# Outputs of a native build in the checkout (zcashd/.gitignore and
# zcashd/depends/.gitignore). CI checkouts never have them; locally they run to
# gigabytes and would change the cache key of the layer that copies them.
depends/built
depends/sources
depends/work
depends/SDKs
depends/x86_64*
depends/aarch64*
depends/i686*
depends/arm*
depends/mips*
zcutil/bin
.cargo/config.toml
.cargo/config
.cargo/.configured-for-*
target
